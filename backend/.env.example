# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:8092

# JWT
JWT_SECRET=change-me-strong-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# Database
# Use DATABASE_URL for managed PostgreSQL providers such as Neon.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=finanzas_latam
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis
# Use REDIS_URL=rediss://... for managed Redis providers such as Upstash.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Password reset email (SMTP)
WEB_APP_URL=http://localhost:8092
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Zentri <no-reply@zentri.app>

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=finanzas-latam-uploads

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Encryption (AES-256 for sensitive fields, must be 32 chars)
ENCRYPTION_KEY=change-me-32-char-secret-key-here
